<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Microsoft.Testing.Platform(MTP):测试工程是可执行文件,xunit.v3 自带 MTP 支持,
      故不再引用 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio(VSTest 适配器)。
      本机 .NET 10 SDK 走原生 MTP 模式,依赖仓库根目录 global.json 的 test.runner 配置。
    -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Gate C 的黄金名单快照(backlog/issues/18):266 行、按序数排序的内建函数注册名。
      改名/删名/加名都必须显式改这个文件,故它要随测试产物一起拷贝。
    -->
    <Content Include="Runtime/Script/Statements/Function/BuiltinMethodNames.snapshot.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Gate D 的源码输入(backlog/issues/18):7 个靠运行期 `Name` 分派的类,其 `switch (Name)` 的
      `case` 标签集合要与该类注册名集合相等。反射看不到 switch 标签,故闸门读源码比对,
      源码必须随测试产物一起拷贝(否则闸门只能靠工作目录定位)。
    -->
    <Content Include="..\Emuera\Runtime\Script\Statements\Function\BuiltinMethod\*.cs"
             Link="BuiltinMethodSources/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      运行测试必须带 -c Debug-NAudio(见 README.md):
      Emuera.csproj 中 NAudio 相关 PackageReference 是按配置条件声明的,
      只有 NAudio 配置才引入包并排除 Sound.WMP.cs(默认配置引用 WMPLib COM,
      dotnet build/test 无法解析)。-c Debug-NAudio 使还原与构建全局一致。
    -->
    <ProjectReference Include="..\Emuera\Emuera.csproj" />
  </ItemGroup>

</Project>
